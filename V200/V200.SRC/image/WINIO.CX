/**----------------------------------------------------------------------------
						Include Files and Type Defines
----------------------------------------------------------------------------**/
#include <windows.h>
#include "host.h"


/**----------------------------------------------------------------------------
						Public Function Prototypes
----------------------------------------------------------------------------**/
INT16 FileClose(INT16 Handle);
INT16 FileCreate(PUINT8 pName);
INT16 FileDelete(PUINT8 pName);
INT32 FileSeek(INT16 Handle, UINT8 Mode, INT32 Offset);
INT32 FileWrite(INT16 Handle, PUINT8 pBuffer, INT32 Length);
INT16 FileOpen(PUINT8 pName);
INT32 FileRead(INT16 Handle, PUINT8 pBuffer, INT32 Length);

/**----------------------------------------------------------------------------
						Private Function Prototypes
----------------------------------------------------------------------------**/
static void SetRawMode(INT16 handle);
void FP DOS3Call(void);

/**----------------------------------------------------------------------------
			  		Global Data Definitions and Declarations
----------------------------------------------------------------------------**/

/**----------------------------------------------------------------------------
						 		Public Code
----------------------------------------------------------------------------**/
/*---------------------------------------------------------------------------*/
INT16 FileClose(INT16 Handle)

/*
**	Parameters:
**		Handle		handle to the file or device.
**	Globals:		None.
**	Operation:
**		This procedure closes the file specified by Handle.
**	Return:		
**		status		0 file closed successfully.
**					-1 if an error occurred.
**	History:
*/

{
	return _lclose(Handle);
}	/* FileClose */


/*---------------------------------------------------------------------------*/
INT16 FileCreate(PUINT8 pName)

/*
**	Parameters:
**		pName		pointer to a null terminated ascii
**					string containing the file or device name.
**	Globals:		None.
**	Operation:
**		Creates a file using the name specified.
**	Return:		
**		handle		handle to the file or device
**					-1 if the operation failed.
**	History:
*/

{
	return _lcreat(pName, 0);
}	/* FileCreate */


/*---------------------------------------------------------------------------*/
INT16 FileDelete(PUINT8 pName)

/*
**	Parameters:
**		pName		pointer to a null terminated ascii
**					string containing the file or device name.
**	Globals:		None.
**	Operation:
**		This procedure deletes the file specified by Handle.
**	Return:		
**		status		Non-Zero, if file deleted successfully.
**					-1 if an error occurred.
**	History:
*/

{
	OFSTRUCT	ofstruct;

	return OpenFile(pName, &ofstruct, OF_DELETE);
}	/* FileDelete */


/*---------------------------------------------------------------------------*/
INT16 FileOpen(PUINT8 pName)

/*
**	Parameters:
**		pName		pointer to a null terminated ascii
**					string containing the file or device name.
**	Globals:		None.
**	Operation:
**		Opens a file using the specified file name.
**	Return:		
**		handle		handle to the open file or device.
**					-1 if the operation failed.
**	History:
*/

{
	INT16	handle;

	if ((handle = _lopen(pName, OF_READWRITE)) != -1) SetRawMode(handle);
	return handle;
}	/* FileOpen */


/*---------------------------------------------------------------------------*/
INT32 FileRead(INT16 Handle, PUINT8 pBuffer, INT32 Length)

/*
**	Parameters:
**		Handle		handle to the file or device.
**		pBuffer		pointer to the data buffer.
**		Length		the size of the data buffer in bytes.
**	Globals:		None.
**	Operation: 
**		Reads data from a file. Reads <= 64K bytes at a time.
**	Return:		
**		count		long integer indicating the bytes read.
**					-1 if an error occurred.
**	History:
*/

{
	return _lread(Handle, pBuffer, (INT16)Length);
}	/* FileRead */


/*---------------------------------------------------------------------------*/
INT32 FileSeek(INT16 Handle, UINT8 Mode, INT32 Offset)

/*
**	Parameters:
**		Handle		handle to the file.
**		Mode		determines how to handle the offset.
**		Offset		the number of bytes -/+
**	Globals:		None.
**	Operation:
**		This procedure positions the file pointer relative to the mode selected.
**	Return:		
**		position	the final position
**		        	-1, if an error occurred.
**	History:
*/

{
	return _llseek(Handle, Offset, Mode);
}	/* FileSeek */


/*---------------------------------------------------------------------------*/
INT32 FileWrite(INT16 Handle, PUINT8 pBuffer, INT32 Length)

/*
**	Parameters:
**		Handle		handle to the file or device.
**		pBuffer		pointer to the data buffer.
**		Length		the size of the data buffer in bytes.
**	Globals:		None.
**	Operation:
**		Writes data to a file. Writes <= 64K bytes at a time.
**	Return:		
**		count		long integer indicating the bytes written.
**					-1 if an error occurred.
**	History:
*/

{
	return _lwrite(Handle, pBuffer, (INT16)Length);
}	/* FileWrite */


/**----------------------------------------------------------------------------
							Private Code
----------------------------------------------------------------------------**/
/*---------------------------------------------------------------------------*/
void SetRawMode(INT16 handle)

/*
**	Parameters:
**		Handle		Handle to the currently opened file.
**	Globals:		None.
**	Operation:
**		This procedure sets the open handle to raw mode.
**	Return:
**		ax		 value of the AX register after the interrupt
**	History:
*/

{
	_asm
	{
		mov		ax,4400h			;get the current device information
		mov		bx,handle
;		call	DOS3Call
		int 21h
		jc		xit

		test	dx,80h				;make sure that this is a character device
		jz		xit

		xor		dh,dh				;set the raw mode bit (bit 5)
		or		dl,20h
		mov		ax,4401h
;		call	DOS3Call
		int	21h
		jc		xit
		xor		ax,ax
	xit:
	}
}
