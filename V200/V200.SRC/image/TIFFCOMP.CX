#include <windows.h>

/**----------------------------------------------------------------------------
						Include Files and Type Defines
----------------------------------------------------------------------------**/
#include "Tiff.h"
#include "HostIO.h"
#include "HostMem.h"

/**----------------------------------------------------------------------------
					 		 Local Definitions
----------------------------------------------------------------------------**/

#define CLEAR_CODE			256
#define END_OF_INFORMATION	257

#define MAX_NODES			0x1000		/* 4k */

/**----------------------------------------------------------------------------
					 	 Local Type Declarations
----------------------------------------------------------------------------**/

typedef struct LZW_ENINFO {	

	UINT16		value;		/* byte value of node */
	
	INT16		left;		/* nodes less than this nodes value */
	INT16		right;		/* nodes greater than this nodes value */
	INT16		next;		/* next character node */

} LZW_ENNODE, FD *PLZW_ENNODE;

typedef struct LZW_DEINFO { /* decode node structure */

	UINT16		value;		/* byte value of node */
	INT16		previous;	/* index to previous node in string */
	
} LZW_DENODE, FD *PLZW_DENODE;

/**----------------------------------------------------------------------------
                          Public Function Prototypes
----------------------------------------------------------------------------**/

/* Public compression routines 
INT16 PackTight  ( PTIFFFILE pTiff, PUINT8 pData, INT32 Lines, 
							INT32 Count, PINT32 pLength ); 
INT16 PackBITS   ( PTIFFFILE pTiff, PUINT8 pData, INT32 Lines, 
							INT32 Count, PINT32 pLength ); 
INT16 PackCCITT  ( PTIFFFILE pTiff, PUINT8 pData, INT32 Lines, 
							INT32 Count, PINT32 pLength ); 
INT16 PackLZW    ( PTIFFFILE pTiff, PUINT8 pData, INT32 Lines, 
							INT32 Count, PINT32 pLength ); 
							
INT16 UnpackTight( PTIFFFILE pTiff, PUINT8 pData, PINT32 Offset, 
				INT32 Lines, INT32 Count );
INT16 UnpackBITS ( PTIFFFILE pTiff, PUINT8 pData, PINT32 Offset, 
				INT32 Lines, INT32 Count );
INT16 UnpackCCITT( PTIFFFILE pTiff, PUINT8 pData, PINT32 Offset, 
				INT32 Lines, INT32 Count );
INT16 UnpackLZW  ( PTIFFFILE pTiff, PUINT8 pData, PINT32 Offset, 
				INT32 Lines, INT32 Count );
*/

/**----------------------------------------------------------------------------
                        Private Function Prototypes
----------------------------------------------------------------------------**/

#ifdef __UNIX__

static INT16 InitializeEncodeTable();
static INT16 TerminateEncodeTable();
static INT16 InitializeDecodeTable();
static INT16 TerminateDecodeTable();
static INT16 CurrentBitsWrite();
static INT16 CurrentBitsRead();
static INT16 WriteCode( /* INT16 handle,UINT16 code */ );
static INT16 WriteLastBits( /* INT16 handle */ );
static INT16 ReadCode( /* INT16 handle */ );
static INT16 NewEnnode( /* UINT16 node,UINT16 value */ );
static INT16 StringInTable( /* PUINT8 string,UINT16 count,PUINT16 pcurrent_node */ );
static INT16 StringFromCode( /* UINT16 code,PUINT8 string,PUINT16 pcount */ );
static INT16 AddStringToTable( /* UINT16 code,UINT8 khar */ );

#else
static INT16 InitializeEncodeTable( void );
static INT16 TerminateEncodeTable( void );
static INT16 InitializeDecodeTable( void );
static INT16 TerminateDecodeTable( void );
static INT16 CurrentBitsWrite( void );
static INT16 CurrentBitsRead( void );
static INT16 WriteCode( INT16 handle,UINT16 code );
static INT16 WriteLastBits( INT16 handle );
static INT16 ReadCode( INT16 handle );
static INT16 NewEnnode( UINT16 node,UINT16 value );
static INT16 StringInTable( PUINT8 string,UINT16 count,PUINT16 pcurrent_node );
static INT16 StringFromCode( UINT16 code,PUINT8 string,PUINT16 pcount );
static INT16 AddStringToTable( UINT16 code,UINT8 khar );
#endif

/**----------------------------------------------------------------------------
                            Local Globals
----------------------------------------------------------------------------**/

#define BUFFER_SIZE		512

static UINT8			buffer[BUFFER_SIZE];	/* global file buffer */
static INT32			bcount=0;				/* number of bytes in buffer */
static INT16			bindex=0;				/* index to buffer */

static PLZW_ENNODE		ennodes=NULL;	/* table/tree for encode nodes */
static PLZW_DENODE		denodes=NULL;	/* table/tree for decode nodes */
static UINT16			next_node;		/* next node to be used */

static UINT32			length=0;		/* number of bytes written or read */
static UINT16			bit_count=0;	/* input/output bit number */
static UINT32			bits;			/* current bit word */

static UINT8 mask_table[8]={ /* table for masking bits */

				0x80,0x40,0x20,0x10,0x08,0x04,0x02,0x01 };

/* The following are the encode tables for CCITT.  The tables are broken down by
   terminating codes, make-up codes, and additional make-up codes.  There are
   separate tables for black and white terminating codes and make-up codes.
   The first two columns are for documentation only.  The first column is
   the run length represented by the entry.  The second column is the bit
   code for the run length, left justified.  The third column is the hex
   number for the bit code.  The fourth column is the number of bits in the
   code. There is also a table with one entry for the end-of-line (eol) code. */
   
#ifdef __CCITT__

