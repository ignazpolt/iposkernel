/**----------------------------------------------------------------------------
                            Public Routines
----------------------------------------------------------------------------**/
/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL PackBITS( pTiff, pData, Lines, Count, pLength )
PTIFFFILE	pTiff;
PUINT8    	pData;
INT32    	Lines;
INT32		Count;
PINT32  	pLength;

/*
**	Parameters:
**	    pTiff   	Pointer to the file data structure.
**	    pData   	Pointer to buffer where unpacked data will reside. 
**	    Lines 		Number of lines to write
**	    Count		Number of bytes per line in memory
**		pLength		Pointer to location for actual number of bytes written
**	Globals:		
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**	    Packs data from memory out to a file using PackBits as specified by 
**		TIFF 5.0 Specification.  Compresses data by counting the number of
**		duplicate bytes in a row and writing out the number of bytes.
**	Return:			
**		status		WRITEEERROR if there was a problem writing the file.
**					OKAY otherwise.
**	History:		None.
*/
{
	INT32		i,j,k;
	PUINT8		data;
	
	INT32		start=0;
	UINT8		count=0;
	INT16		status=OKAY;
	INT32		length;  /* this hides global */
	
	bcount=0;
	
/* move to end of file */

	if (FileSeek(pTiff->Handle,(UINT8) SEEK_END, 0L) == -1)
		{ status = WRITEERROR; goto xit; }

/* write out image, one line at a time */

	length=0L;
	for (i=0L;i<Lines;i++) {
	
		j=0L;
		data=pData+Count*i; /* data = start of line */
		
		while(j<pTiff->WidthBytes) {
		
			start=j;
			
			if (data[j]==data[j+1]) { /* do a repeat run */
			
				while((j<(pTiff->WidthBytes-1))&&(data[j]==data[j+1])&&
					((j-start)<127)) j++;
				j++;
				
				count=(UINT8)(j-start); /* count = number of bytes in run */
				
				count=(UINT8)(1-count); /* convert for file output */
				
				buffer[bcount++]=(UINT8)count;
				if (bcount==BUFFER_SIZE) {
					if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
						{status=WRITEERROR; goto xit; }
					bcount=0;
				}
					
				buffer[bcount++]=(UINT8)data[j-1];
				if (bcount==BUFFER_SIZE) {
					if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
						{status=WRITEERROR; goto xit; }
					bcount=0;
				}
				length+=2L;
			}
			else { /* do a literal run */

				while((j<(pTiff->WidthBytes))&&(data[j]!=data[j+1])
					&&((j-start)<128)) j++;
				
				count=(UINT8)(j-start); /* count= number of bytes in run */
				
				count=count-(UINT8)1; /* convert for file output */
				
				buffer[bcount++]=(UINT8)count;
				if (bcount==BUFFER_SIZE) {
					if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
						{status=WRITEERROR; goto xit; }
					bcount=0;
				}
					
				for (k=0;k<(count+1);k++) {
					buffer[bcount++]=(UINT8)data[start+k];
					if (bcount==BUFFER_SIZE) {
						if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
							{status=WRITEERROR; goto xit; }
						bcount=0;
					}
				}
				length+=count+2L;
			}
		}		
	}
	if (bcount>0) {
		if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
			{status=WRITEERROR; goto xit; }
		bcount=0;
	}

	*pLength=length;
	
xit: return( status );
} /* PackBITS */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL PackCCITT( pTiff, pData, Lines, Count, pLength )
PTIFFFILE	pTiff;
PUINT8    	pData;
INT32    	Lines;
INT32   	Count;
PINT32  	pLength;
/*
**	Parameters:
**	    pTiff   	Pointer to the file data structure.
**	    pData   	Pointer to buffer where unpacked data will reside. 
**	    Lines 		Number of lines to write
**	    Count		Number of bytes per line in memory
**		pLength		Pointer to location for actual number of bytes written
**	Globals:
**		mask_table		Table of bit indexes.
**		encode_addition	Table of additional codes.
**		encode_bmake	Table of make-up codes for black runs.
**		encode_wmake	Table of make-up codes for white runs.
**		encode_bterm	Table of terminating codes for black runs.
**		encode_wterm	Table of terminating codes for white runs.
**		bcount			Current byte count in global buffer.
**		buffer			Global buffer for file IO.
**	Operation:
**		Compresses data from memory out to a file using CCITT run-length compression
**		as specified in the TIFF 5.0 Specification.  Tables are used to find the 
**		code and bit length of the code for each run length.
**	Return:			
**		status		WRITEERROR if a problem occured writing the file.
**					OKAY otherwise.
**	History:		None.
**
**	Notes:
**		The compression and decompression for CCITT rely heavily on the tables
**		defined at the start of the file.  For compression the "encode" tables 
**		are used.  These tables give the code and length of the code for each
**		run length of white or black.
*/

{
	INT16		status=OKAY;

#ifdef __CCITT__

	INT32		i,x;
	INT16		count=0;

	INT32		length;  		/* this decl hides global decl */
	PUINT8		data;
	INT16		bit_count;  	/* this decl hides global decl */
	INT16		num_bits;
	UINT32		bits;  			/* this decl hides global decl */
	UINT32		new_bits;
	INT16		type;
	BOOLEAN		term_flag;
	INT16		index;
	INT16		sbits;
	INT32		pixel_count;
	UINT8		byte1;
	INT16		white_pixel;
	
	bcount=0;
	
/* move to end of file */

	if (FileSeek(pTiff->Handle,(UINT8) SEEK_END, 0L) == -1)
		{ status = WRITEERROR; goto xit; }

/* setup white_pixel to match image interpretation */

	if (pTiff->PhotoInterpret==0) white_pixel=0; /* white is zero */
	else white_pixel=1; /* white is one */
		
/* write out image, one line at a time */

	length=0L;
	for (i=0L;i<Lines;i++) {
	
		x=0L;
		type=white_pixel;
		bit_count=0;
		bits=0;
		sbits=0;
		data=pData+Count*i; /* data = start of line */
		pixel_count=0L;
		
		while (pixel_count<pTiff->ImageWidth) {
					
/* find the number of black or white pixels in a row */

			count=0;
			if (type==0) {
			
				while (((data[x]&mask_table[sbits])==0x00)&&
					(pixel_count<pTiff->ImageWidth)) {
				
					sbits++;
					count++;
					pixel_count++;
					if (sbits==8) {
						sbits=0;
						x++;
					}
				}
			}
			else {
				
				while (((data[x]&mask_table[sbits])==mask_table[sbits])&&
					(pixel_count<pTiff->ImageWidth)) {
					
					sbits++;
					count++;
					pixel_count++;
					if (sbits==8) {
						sbits=0;
						x++;
					}
				}
			}
	
/* find the new bit pattern and the number of bits in the tables */

			term_flag=FALSE;
			while (term_flag==FALSE) {
				
				if (count>2560) { /* write out longest available */
				
					new_bits=encode_addition[12][0];
					num_bits=encode_addition[12][1];
					count-=2560;
				}
				else if (count>1791) { /* use additional make-up codes */
					index=(count-1792)/64;
					new_bits=encode_addition[index][0];
					num_bits=encode_addition[index][1];
					count=count-1792-index*64;
				} 
				else if (count>63) { 
					index=(count-64)/64;
					if (type==white_pixel) { /* use white make-up codes */
						new_bits=encode_wmake[index][0];
						num_bits=encode_wmake[index][1];
					}  
					else { /* use black make-up codes */
						new_bits=encode_bmake[index][0];
						num_bits=encode_bmake[index][1];
					}
					count=count-64-index*64;
				} 
				else { /* count <=63 */
				
					if (type==white_pixel) { /* use white terminating codes */
						new_bits=encode_wterm[count][0];
						num_bits=encode_wterm[count][1];
					} 
					else { /* use black terminating codes */
						new_bits=encode_bterm[count][0];
						num_bits=encode_bterm[count][1];
					}
					term_flag=TRUE;
					count=0;
				}
		
/* add the new bits to the current bit stream */

				new_bits=new_bits<<(16-bit_count);
				bits=bits|new_bits;
				bit_count=bit_count+num_bits;
				if (bit_count>16) {
					buffer[bcount++]=(UINT8)((bits>>24)&0xff);
					if (bcount==BUFFER_SIZE) {
						if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
							{status=WRITEERROR; goto xit; }
						bcount=0;
					}
					buffer[bcount++]=(UINT8)((bits>>16)&0xff);
					if (bcount==BUFFER_SIZE) {
						if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
							{status=WRITEERROR; goto xit; }
						bcount=0;
					}
					length+=2;
					bits<<=16;
					bit_count-=16;
				}
			} /* while term_flag==FALSE */

			if (type==0) type=1;
			else type=0;

		} /* end of line */

/* write out last bytes at the end of line */

		if (bit_count>8) {
			buffer[bcount++]=(UINT8)((bits>>24)&0xff);
			if (bcount==BUFFER_SIZE) {
				if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
					{status=WRITEERROR; goto xit; }
				bcount=0;
			}
			buffer[bcount++]=(UINT8)((bits>>16)&0xff);
			length += 2;
		}
		else if (bit_count>0) {
			buffer[bcount++]=(UINT8)((bits>>24)&0xff);
			length++;
		}
		if (bcount>0) {
			if (FileWrite(pTiff->Handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
				{status=WRITEERROR; goto xit; }
			bcount=0;
		}
	}

xit:
	*pLength=length;

#endif

	return( status );
} /* PackCCITT */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL PackLZW( pTiff, pData, Lines, Count, pLength )
PTIFFFILE	pTiff;
PUINT8    	pData;
INT32    	Lines;
INT32   	Count;
PINT32  	pLength;

/*
**	Parameters:
**	    pTiff   	Pointer to the file data structure.
**	    pData   	Pointer to buffer where unpacked data will reside. 
**	    Lines 		Number of lines to write
**	    Count		Number of bytes per line in memory
**		pLength		Pointer to location for actual number of bytes written
**	Globals:
**		ennodes		Pointer to encoding table.
**		next_node	Pointer to the next available node in the encode table.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Compresses data out to a file using LZW compression as specified by the
**		TIFF 5.0 Specification.  
**	Return:			
**		status		WRITEERROR if a problem occurs writing the file.
**					UNSUPPORTEDERROR if unsupported predictor code.
**					OKAY otherwise.
**	History:		None.
*/

{
	return(UNSUPPORTEDERROR);
} /* PackLZW */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL PackTight( pTiff, pData, Lines, Count, pLength )
PTIFFFILE	pTiff;
PUINT8    	pData;
INT32    	Lines;
INT32   	Count;
PINT32  	pLength;

/*
**	Parameters:
**	    pTiff   	Pointer to the file data structure.
**	    pData   	Pointer to buffer where unpacked data will reside. 
**	    Lines   	Number of lines to write
**	    Count   	Number of bytes per line in memory
**	    pLength 	Pointer to location for actual number of bytes written
**	Globals:    	None.
**	Operation:
**	Return:
**	Return:			
**		status		WRITEERROR if a problem occurs writing the file.
**					OKAY otherwise.
**	History:
*/

{
	INT16	status = OKAY;
	INT32	i;
	
	if (FileSeek(pTiff->Handle,SEEK_END, 0L) == -1 )
		{ status = WRITEERROR; }
	else {

		if ( pTiff->WidthBytes==Count) { /* no padding in memory */
			if (FileWrite(pTiff->Handle, pData, pTiff->WidthBytes*Lines) !=
			    pTiff->WidthBytes*Lines) { status = WRITEERROR; }
		}
		else {
			for (i=0L;(i<Lines)&&(status==OKAY);i++,pData+=Count)
				if (FileWrite(pTiff->Handle,pData,pTiff->WidthBytes)!=pTiff->WidthBytes)
					{ status = WRITEERROR; }
		}
	}

	*pLength=pTiff->WidthBytes*Lines; /* to pad or not to pad, that is the question! */

	return( status );

} /* PackTight */


/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL UnpackBITS(pTiff, pData, pOffset, Lines, Count )
PTIFFFILE	pTiff;
PUINT8    	pData;
PINT32   	pOffset;
INT32    	Lines;
INT32   	Count;

/*
**	Parameters:
**		pTiff		Pointer to the file data structure.
**		pData		Pointer to where to place data in memory.
**		pOffset		Pointer to current offset in file.
**		Lines		Number of lines to unpack.
**		Count		Number of bytes per line for data in memory.
**	Globals:		
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Decompresses files compressed with PackBits compression as specified in
**		TIFF 5.0 Specification.
**	Return:
**		status		READERROR if there was a problem reading from the file.
**					OKAY otherwise.
**	History:		None.
*/

{
	INT32		i,j,k;
	INT8		count=0;
	INT8		temp;

	INT32		line_index=0,index;
	INT16		status=OKAY;
	
	if (FileSeek(pTiff->Handle, SEEK_SET, (INT32) *pOffset) != (INT32) *pOffset)
		{ status = READERROR; goto xit; }
	
/* setup buffer initially */

	bcount=0;
	
	for (i=0L;i<Lines;i++) {
	
		index=line_index;
		while (index<(line_index+pTiff->WidthBytes)) {
		
			if (bcount==0) {
				bcount=FileRead(pTiff->Handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
				if (bcount==0) { status=READERROR; goto xit; }
				bindex=0;
			}
			count=buffer[bindex++];
			bcount--;
				
			if ((count>=0)&&(count<=127)) { /* get literal bytes */
			
				for (k=0;k<(count+1);k++) {
					if (bcount==0) {
						bcount=FileRead(pTiff->Handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
						if (bcount==0) { status=READERROR; goto xit; }
						bindex=0;
					}
					pData[index++]=buffer[bindex++];
					bcount--;
				}
			}
			else if ((count<=-1)&&(count>=-127)) { /* get repeat bytes */
			
				if (bcount==0) {
					bcount=FileRead(pTiff->Handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
					if (bcount==0) { status=READERROR; goto xit; }
					bindex=0;
				}
				temp=buffer[bindex++];
				bcount--;
				for (j=0;j<(1-count);j++) pData[index++]=temp;
			}
		}
		line_index+=Count;
	}
xit:	return(status);

} /* UnpackBITS */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL UnpackCCITT(pTiff, pData, pOffset, Lines, Count )
PTIFFFILE	pTiff;
PUINT8    	pData;
PINT32   	pOffset;
INT32    	Lines;
INT32		Count;

/*
**	Parameters:
**		pTiff		Pointer to the file data structure.
**		pData		Pointer to where to place data in memory.
**		pOffset		Pointer to current offset in file.
**		Lines		Number of lines to unpack.
**		Count		Number of bytes per line for data in memory.
**	Globals:
**		mask_table		Bit index table.
**		decode_addition	Pointer to decode table for additional codes.
**		decode_w0		Pointer to decode table for white run codes begining with 0.
**		decode_w1		Pointer to decode table for white run codes begining with 1.
**		decode_b0123	Pointer to decode table for black run codes begining with 0,1,2,or
**						3 zeros.
**		decode_b4		Pointer to decode table for black run codes begining with four zeros.
**		decode_b5		Pointer to decode table for black run codes begining with five zeros.
**		decode_b6		Pointer to decode table for black run codes begining with six zeros.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Decodes a file that has been compressed with CCITT compression as specified in 
**		TIFF 5.0 Specification.
**	Return:
**		status		READERROR if there was a problem reading from the file.
**					OKAY otherwise.
**	History:		None.
**
**	Notes:
**		The compression and decompression for CCITT rely heavily on the tables
**		defined at the start of the file.  For decompression the tables contain
**		the run length and number of bits in the code.  Decompression poses a
**		interesting problem in that the decompressor does not know the length 
**		of the code it is currently trying to decipher.  To deal with this the
**		tables are accessed with more bits than are in any code word (i.e. for 
**		codes that have from 1 to 5 bits, 5 bits will always be used to access 
**		the table).  In order to minimize the size of the tables some basic 
**		heuristics are applied to break the possible codes into groups.  Each 
**		group has a corresponding table.  The tables are defined under "Globals" 
**		above.
*/

{
	INT16		status=OKAY;		/* current status */

#ifdef __CCITT__

	INT32		i,j;
	UINT8		byte1=0,byte2=0;	/* parsing bytes from input string */
	INT16		type=0;				/* current type of data being output */
	INT32		index;
	INT32		dindex;				/* destination array index */
	INT16		count=0;			/* number of white or black pixels to write */
	INT16		bit_count=0;		/* number of bits in command word string */
									/* bit_count decl hides global decl */
	INT16		dbits=0;			/* current number of bits in the destination byte */
	INT16		out_count=0;		/* number of pixels written */
	INT16		in_count=0;			/* number of bits in the in_bits variable */
	UINT32		in_bits=0;			/* holds the input data stream */
	UINT16		in_bytes=0;			/* temporary buffer for input data */
	INT32		pixel_count;		/* number of pixels written in line */
	UINT8   	temp;
	INT16		eol_flag;			/* flag to indicate an end-of-line condition */
	INT16		white_pixel;			/* image interpretation of a white pixel */
	
/* move to start of data */

	if (FileSeek(pTiff->Handle, SEEK_SET, (INT32) *pOffset) != (INT32) *pOffset)
		{ status = READERROR; goto xit; }

/* setup white_pixel to match image interpretation */

	if (pTiff->PhotoInterpret==0) white_pixel=0; /* white is zero */
	else white_pixel=1; /* white is one */
		
/* decode each line of data into pData */

	in_bits=0;
	in_count=0;
	bcount=0;
	
	for (i=0;i<Lines;i++) {

		dindex=i*Count;
	
		for (j=0;j<pTiff->WidthBytes;j++) pData[dindex+j]=0;
		
		dbits=0;
		pixel_count=0L;
		type=white_pixel;
		
		eol_flag=FALSE;
		while (eol_flag==FALSE) {

/* get the next two bytes */

			if (in_count<16) {

				if (bcount==0) {
					bcount=FileRead(pTiff->Handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
					if (bcount==0) { /* ignore errors for bit stream */ }
					bindex=0;
				}

				temp=buffer[bindex++];
				bcount--;
				
				in_bytes=temp<<8;
				
				if (bcount==0) {
					bcount=FileRead(pTiff->Handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
					if (bcount==0) { /* ignore errors for bit stream */ }
					bindex=0;
				}
				
				temp=buffer[bindex++];
				bcount--;

				in_bytes=in_bytes|temp;
				
				in_bits |= ((UINT32)in_bytes<<(16-in_count));
				in_count+=16;
			}
			byte1=(UINT8)(in_bits>>24)&0xff;
			byte2=(UINT8)(in_bits>>16)&0xff;
				
/* get the length of the code and the run length */

			if (byte1==0x01) { /* additional make up codes */
			
				index=byte2>>4;
				count=decode_addition[index][0];
				bit_count=decode_addition[index][1];
			}
			else if (type==white_pixel) { /* white data */
			
				if ((byte1&0x80)==0x00) { /* white with top bit clear */
				
					index=((byte1<<1)|(byte2>>7))&0xff;
					count=decode_w0[index][0];
					bit_count=decode_w0[index][1];
				}
				else { /* white with top bit set */
				
					index=(byte1>>2)&0x1f; /* take the lower 5 bits */
					count=decode_w1[index][0];
					bit_count=decode_w1[index][1];
				}
			}
			else { /* black data */
			
				if ((byte1&0xfc)==0x00) { /* black with 6 bits zero */
				
					index=((byte1<<5)|(byte2>>3))&0x3f;
					count=decode_b6[index][0];
					bit_count=decode_b6[index][1];
					
				} else if ((byte1&0xf8)==0x00) { /* black with 5 bits zero */
				
					index=((byte1<<4)|(byte2>>4))&0x3f;
					count=decode_b5[index][0];
					bit_count=decode_b5[index][1];
					
				} else if ((byte1&0xf0)==0x00) { /* black with 4 bits zero */
				
					index=((byte1<<4)|(byte2>>4))&0x7f;
					count=decode_b4[index][0];
					bit_count=decode_b4[index][1];
				}
				else { /* black with 0-3 bits zero */
				
					index=(byte1>>2)&0x3f;
					count=decode_b0123[index][0];
					bit_count=decode_b0123[index][1];
				}
			}

/* write out the correct number of pixels */

			out_count=0;
			if (type==0) { /* zero data */
				while (out_count<count) { /* put each bit out one at a time */
					dbits++;
					out_count++;
					pixel_count++;
					if (dbits==8) { /* hit end-of-byte, move on */
						dindex++;
						dbits=0;
					}
				}
			}
			else { /* ones data */
				while (out_count<count) { /* put out each bit */
					pData[dindex]|=mask_table[dbits++];
					out_count++;
					pixel_count++;
					if (dbits==8) { /* hit end-of-byte, move on */
						dindex++;
						dbits=0;
					}
				}
			}
			
/* if count<64 then terminate */

			if (count<64) {
				if (type==0) type=1;
				else type=0;
			}
		
/* update input bit string */

			in_bits=in_bits<<bit_count;
			in_count-=bit_count;
			
			if ((pixel_count>=pTiff->ImageWidth)&&(count<64)) eol_flag=TRUE;
		}

/* update input bit string for start of a new line (byte align it) */

		in_bits=in_bits<<(in_count%8);
		in_count=in_count-(in_count%8);
	}

#endif

xit:	return(status);

} /* UnpackCCITT */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL UnpackLZW(pTiff, pData, pOffset, Lines, Count )
PTIFFFILE	pTiff;
PUINT8    	pData;
PINT32   	pOffset;
INT32    	Lines;
INT32		Count;

/*
**	Parameters:
**		pTiff		Pointer to the file data structure.
**		pData		Pointer to where to place data in memory.
**		pOffset		Pointer to current offset in file.
**		Lines		Number of lines to unpack.
**		Count		Number of bytes per line for data in memory.
**	Globals:
**		denodes		Pointer to decode table.
**		next_node	Pointer to next available node in decode table.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Decompresses files that have been compressed with LZW compression as specified
**		in TIFF 5.0 Specification.
**	Return:
**		status		READERROR if there was a problem reading from the file.
**					UNSUPPORTEDERROR if unsupported predictor code.
**					OKAY otherwise.
**	History:		None.
*/

{
	return(UNSUPPORTEDERROR);
} /* UnpackLZW */

/*---------------------------------------------------------------------------*/
INT16 FAR PASCAL UnpackTight(pTiff, pData, pOffset, Lines, Count )
PTIFFFILE	pTiff;
PUINT8    	pData;
PINT32   	pOffset;
INT32    	Lines;
INT32   	Count;

/*
**	Parameters:
**		pTiff		Pointer to the file data structure.
**		pData		Pointer to where to place data in memory.
**		pOffset		Pointer to current offset in file.
**		Lines		Number of lines to unpack.
**		Count		Number of bytes per line for data in memory.
**	Globals:		None.
**	Operation:
**		Reads data from file and places in memory.
**	Return:
**		status		READERROR if there was a problem reading from the file.
**					OKAY otherwise.
**	History:		None.
*/

{
	INT16	status = OKAY;
	INT32	i;

	if (FileSeek(pTiff->Handle, SEEK_SET, (INT32) *pOffset) != (INT32) *pOffset)
		{ status = READERROR; }
	else {
		if (pTiff->WidthBytes==Count) { /* no padding */
			if (FileRead(pTiff->Handle, pData, Count*Lines) == -1)
				{ status = READERROR; }
		}
		else {
			for (i=0L;(i<Lines)&&(status==OKAY);i++,pData+=Count)
				if (FileRead(pTiff->Handle,pData,pTiff->WidthBytes) == -1)
					{ status = READERROR; }
		}
	}
	return( status );

} /* UnpackTight */

/**----------------------------------------------------------------------------
							Private Routines for LZW
----------------------------------------------------------------------------**/

/**--------------------------- Table Routines ------------------------------**/

/*---------------------------------------------------------------------------*/
static INT16 InitializeEncodeTable( )
/*
**	Parameters: 	None. 
**	Globals:
**	    ennodes		Pointer to encoding table.
**		next_node	Next available node in the table.
**	Operation:  	
**		Allocate the encode table the first time called.
**		Initializes the encode table with the first 256
**		strings (i.e. 0-ff).
**	Return: 		
**		status		OKAY if successful.
**					MEMORYERROR otherwise.
**	History: 		Spotty.
*/
{
	UINT32		size;
	UINT16		i;
	
	if (ennodes==NULL) {
	
		size=(UINT32)sizeof(LZW_ENNODE)*(UINT32)MAX_NODES;
		ennodes=(PLZW_ENNODE)AllocPointer(size);
		if (ennodes==NULL) return(MEMORYERROR);
	}
	
	for (i=0;i<256;i++) NewEnnode(i,i);
	next_node=256;
	
	for (i=256;i<MAX_NODES;i++) NewEnnode(i,0);
	
	return(OKAY);
	
} /* InitializeEncodeTable */

/*---------------------------------------------------------------------------*/
static INT16 TerminateEncodeTable( )
/*
**	Parameters:		None.
**	Globals:
**		ennodes		Pointer to encoding table.
**	Operation:		
**		Deallocates the encode table.
**	Return:			
**		status		OKAY always, cannot fail.
**	History:		None.
*/
{
	if (ennodes!=NULL) DumpPointer((PUINT8)ennodes);
	ennodes=NULL;
	return(OKAY);
} /* TerminateEncodeTable */

/*---------------------------------------------------------------------------*/
static INT16 InitializeDecodeTable( )
/*
**	Parameters:		None.
**	Globals:
**		denodes		Pointer to decode table.
**		next_node	Next available node in the table.
**	Operation:		
**		Allocates the decode table.  Initializes the table with the first 
**		256 entries.
**	Return:			
**		status		OKAY if allocate is successful.
**					MEMORYERROR if allocation failed.
**	History:		None.
*/
{
	UINT32		size;
	UINT16		i;
	
	if (denodes==NULL) {
	
		size=(UINT32)sizeof(LZW_DENODE)*(UINT32)MAX_NODES;
		denodes=(PLZW_DENODE)AllocPointer(size);
		if (denodes==NULL) return(MEMORYERROR);
	}
	
	for (i=0;i<256;i++) {
		denodes[i].value = i;
		denodes[i].previous = -1;
	}
	next_node=256;
	
	for (i=256;i<MAX_NODES;i++) {
		denodes[i].value = 0;
		denodes[i].previous = -1;
	}

	return(OKAY);
} /* InitializeDecodeTable */
	
/*---------------------------------------------------------------------------*/
static INT16 TerminateDecodeTable( )
/*
**	Parameters:		None.
**	Globals:
**		denodes		Pointer to decoding table.
**	Operation:		
**		Deallocates the decoding table.
**	Return:			
**		status		OKAY always, cannot fail.
**	History:		None.
*/
{
	if (denodes!=NULL) DumpPointer((PUINT8)denodes);
	denodes=NULL;
	return(OKAY);
} /* TerminateDecodeTable */

/**-------------------- Read/Write Bit Stream Routines -----------------------**/

/*---------------------------------------------------------------------------*/
static INT16 CurrentBitsWrite( )
/*
**	Parameters:		None.
**	Globals:
**		next_node	Next available node in the LZW encode tree.
**	Operation:		Returns the number of bits per code word for the next node
**					in the tree.
**	Return:			
**		retval		Number of bits per code word for the next node in the tree.
**	History:		None.
*/
{
	INT16	retval;

	if (next_node<=(512-2)) retval = 9;
	else if (next_node<=(1024-2)) retval = 10;
	else if (next_node<=(2048-2)) retval = 11;
	else retval = 12;

	return(retval);
} /* CurrentBitsWrite */

/*---------------------------------------------------------------------------*/
static INT16 CurrentBitsRead( )
/*
**	Parameters:		None.
**	Globals:
**		next_node	Next avilable node in the LZW decode tree.
**	Operation:		
**		Returns the number of bits per code word for the next node
**		in the tree.
**	Return:			
**		retval		Number of bits of the next code word.
**	History:		None.
*/
{
	INT16	retval;
	INT16	node;
	
	node=next_node+2;
	
	if (node<=(512-2)) retval = 9;
	else if (node<=(1024-2)) retval = 10;
	else if (node<=(2048-2)) retval = 11;
	else retval = 12;

	return(retval);
} /* CurrentBitsRead */

/*---------------------------------------------------------------------------*/
static INT16 WriteCode(handle,code)
INT16		handle;
UINT16		code;
/*
**	Parameters:		
**		handle		Handle to an open file.
**		code		Code word to write.
**	Globals:
**		bits		Current output bit stream.
**		bit_count	Number of bits in output bit stream.
**		length		Number of bytes written to file.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Adds the specfied code word to the output stream for an LZW compressed
**		image.  If the bit stream is longer than 16 bits, two bytes will be written
**		to the file.
**	Return:
**		status		WRITEERROR if an error occured on writing to the file.
**					OKAY otherwise.
**	History:
*/
{
	UINT32		new_bits;
	UINT32		num_bits;

	num_bits=(INT16)CurrentBitsWrite();
	new_bits=(UINT32)code<<(16-num_bits);
	bits |= new_bits<<(16-bit_count);
	bit_count += (INT16)num_bits;
	
	if (bit_count>16) {

		buffer[bcount++]=(UINT8)(bits>>24)&0xff;
		buffer[bcount++]=(UINT8)(bits>>16)&0xff;
		if (bcount==BUFFER_SIZE) {
			if (FileWrite(handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
				return(WRITEERROR);
			bcount=0;
		}
		length += 2;
		bits <<= 16;
		bit_count -= 16;
	}
	return(OKAY);
} /* WriteCode */

/*---------------------------------------------------------------------------*/
static INT16 WriteLastBits(handle)
INT16		handle;
/*
**	Parameters:
**		handle		Handle to an open file.
**	Globals:
**		bits		Current output bit stream.
**		bit_count	Number of bits in output bit stream.
**		length		Number of bytes written to file.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Writes any remaining bits from the output stream to the file.
**	Return:
**		status		WRITEERROR if an error occured on writing to the file.
**					OKAY otherwise.
**	History:		None.
*/
{
	if (bit_count>0) {
		buffer[bcount++]=(UINT8)(bits>>24)&0xff;
		length++;
	}
	if (bit_count>8) {
		buffer[bcount++]=(UINT8)(bits>>16)&0xff;
		length++;
	}

	if (bcount>0) {
		if (FileWrite(handle,(PUINT8)buffer,(INT32)bcount)!=bcount)
			return(WRITEERROR);
		bcount=0;
	}
	
	return(OKAY);
} /* WriteLastBits */

/*---------------------------------------------------------------------------*/
static INT16 ReadCode(handle)
INT16	handle;
/*
**	Parameters:
**		handle		Handle to an open file.
**	Globals:
**		bits		Current output bit stream.
**		bit_count	Number of bits in output bit stream.
**		bcount		Current byte count in global buffer.
**		buffer		Global buffer for file IO.
**	Operation:
**		Returns a code word from the input stream.  If the input stream is
**		less than 16 bit two more bytes will be read from the file.
**	Return:
**		code		Next avilable code word from the input stream.
**	History:
*/
{
	UINT16		num_bits;
	UINT16		code;
	
	if (bit_count<16) {
		
		if (bcount==0) {
			bcount=FileRead(handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
			if (bcount==0) {} /* ignore errors for bit stream */
			bindex=0;
		}

		bits |= ((UINT32)buffer[bindex++]<<(24-bit_count));
		bcount--;
length++;
		if (bcount==0) {
			bcount=FileRead(handle,(PUINT8)buffer,(INT32)BUFFER_SIZE);
			if (bcount==0) {} /* ignore errors for bit stream */
			bindex=0;
		}

		bits |= ((UINT32)buffer[bindex++]<<(16-bit_count));
		bcount--;
length++;

		bit_count += 16;
	}
	num_bits=CurrentBitsRead();
	code=(UINT16)(bits>>(32-num_bits));
	bits <<= num_bits;
	bit_count -= num_bits;
	return(code);
} /* ReadCode */

/**------------------------- Encode Routines ----------------------------**/

/*---------------------------------------------------------------------------*/
static INT16 NewEnnode(node,value)
UINT16		node;
UINT16		value;
/*
**	Parameters:
**		node		Node in table to initialize.
**		value		Value to initialize node to.
**	Globals:
**		ennodes		Pointer to encoding table.
**	Operation:
**		Initializes a node in the encoding table to the value specified.
**	Return:			OKAY always
**	History:		None.
*/
{
	ennodes[node].value = value;
	ennodes[node].left  = -1;
	ennodes[node].right = -1;
	ennodes[node].next  = -1;

	return(OKAY);
} /* NewEnnode */

/*---------------------------------------------------------------------------*/
static INT16 StringInTable(string,count,pcurrent_node)
PUINT8		string;
UINT16		count;
PUINT16		pcurrent_node;
/*
**	Parameters:
**		string			Current string being matched sought in tree.
**		count			Index to string for current character.
**		pcurrent_node	Pointer to the location to place the new node location.
**	Globals:
**		next_node		Next available node in LZW tree.
**		ennodes			Pointer to encoding table.
**	Operation:
**		If this is the first character in the string the current node is set
**		to the top level of the tree.  Otherwise we will transition to the next
**		level in the tree and search for an occurance of the character there.
**		if one is found we return with TRUE.  If not the new node will be
**		added to the tree and FALSE will be returned.
**	Return:
**		result		TRUE if string was already in table.
**					FALSE if string had to be added to table.
**	History:		None.
*/
{
	UINT8		khar; /* current character in string */
	
	khar=string[count-1];
	
	if (count==1) { /* single character string, always first 256 entries in table */
	
		*pcurrent_node=khar;
		return(TRUE);
	}
	else {
		
		if (ennodes[*pcurrent_node].next == -1) { /* if no next char entry */
		
			ennodes[*pcurrent_node].next=next_node;
			*pcurrent_node=next_node;
			NewEnnode(*pcurrent_node,khar); /* next_node is always>255 */
			next_node++;
			return(FALSE);
		}
		else {
			*pcurrent_node=ennodes[*pcurrent_node].next;
			while (TRUE) {
			
				if (khar==(UINT8)ennodes[*pcurrent_node].value) {
					return(TRUE);
				} 
				else if (khar<(UINT8)ennodes[*pcurrent_node].value) {
					
					if (ennodes[*pcurrent_node].left != -1) {
						*pcurrent_node=ennodes[*pcurrent_node].left;
					}
					else { /* create new left node */
						ennodes[*pcurrent_node].left=next_node;
						*pcurrent_node=next_node;
						NewEnnode(*pcurrent_node,khar);
						next_node++;
						return(FALSE);
					}
				}
				else { /* khar must be greater than the current value */
					if (ennodes[*pcurrent_node].right != -1) { 
						*pcurrent_node=ennodes[*pcurrent_node].right;
					}
					else { /* create new right node */
						ennodes[*pcurrent_node].right=next_node;
						*pcurrent_node=next_node;
						NewEnnode(*pcurrent_node,khar);
						next_node++;
						return(FALSE);
					}
				}
			}
		}
	}
} /* StringInTable */

/**------------------------- Decode Routines ----------------------------**/

/*---------------------------------------------------------------------------*/
static INT16 StringFromCode(code,string,pcount)
UINT16		code;
PUINT8		string;
PUINT16		pcount;
/*
**	Parameters:
**		code		Code to look for string with.
**		string		Pointer to location to place string at in memory.
**		pcount		Pointer to value for the length of the string.
**	Globals:
**		denodes		Pointer to the decoding table.
**	Operation:
**		Using the code as the starting node in the decode tree this routine
**		builds the string by traversing backwards up the tree.
**	Return:			OKAY always, cannot fail.
**	History:
*/
{
	UINT16		index;
	INT16		node;

	if (code>255) node=code-2; /* remove for extra codes */
	else node=code;
		
	index=0; /* start at end of string */
	while (node != -1) { /* build string backwards */
		
		string[index++]=(UINT8)denodes[node].value;
		node=denodes[node].previous;
	}
	*pcount=index;

	return(OKAY);
} /* StringFromCode */

/*---------------------------------------------------------------------------*/
static INT16 AddStringToTable(code,khar)
UINT16		code;
UINT8		khar;
/*
**	Parameters: 
**		code		Code for previous entry in table.
**		khar		Value for new node.
**	Globals:
**		denodes		Pointer to decoding table.
**		next_node	Index to next available node in table.
**	Operation:
**		Adds a new node to the decode table and links it back to the last
**		code for the current string.
**	Return:			OKAY always, cannot fail.
**	History:		None.
*/
{
	denodes[next_node].value=khar;
	if (code<256) denodes[next_node].previous=code;
	else denodes[next_node].previous=code-2;
	next_node++;

	return(OKAY);
} /* AddStringToTable */

/* end TiffComp.c */

