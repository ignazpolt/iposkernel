/* The following are the decode tables for CCITT. The tables are broken
   down based on the value of the first bits in the codes.  This allows
   the number and size of the talbes to be cut down considerably.  There
   are two tables for white codes, one with codes starting with 1 and
   one with codes starting with 0.  There are four tables for black codes,
   one for codes with less than four starting zeros, one with four 
   starting zeros, one with five starting zeros and one with six starting
   zeros.  The first column is used for documentation only and 
   shows the index value used to access the table.  The second column
   is the length of the run and the fourth column is the number of
   bits in the run. */

static INT16 decode_w1[32][2]={ /* white codes starting with 1 */

/* 00 */		3,			4,
/* 01 */		3,			4,
/* 02 */		3,			4,
/* 03 */		3,			4,
/* 04 */		128,		5,
/* 05 */		128,		5,
/* 06 */		8,			5,
/* 07 */		8,			5,
/* 08 */		9,			5,
/* 09 */		9,			5,
/* 0A */		16,			6,
/* 0B */		17,			6,
/* 0C */		4,			4,
/* 0D */		4,			4,
/* 0E */		4,			4,
/* 0F */		4,			4,
/* 10 */		5,			4,
/* 11 */		5,			4,
/* 12 */		5,			4,
/* 13 */		5,			4,
/* 14 */		14,			6,
/* 15 */		15,			6,
/* 16 */		64,			5,
/* 17 */		64,			5,
/* 18 */		6,			4,
/* 19 */		6,			4,
/* 1A */		6,			4,
/* 1B */		6,			4,
/* 1C */		7,			4,
/* 1D */		7,			4,
/* 1E */		7,			4,
/* 1F */		7,			4	};

