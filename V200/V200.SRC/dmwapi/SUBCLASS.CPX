static int GetSystemFontHeight ()
  {
  HDC hDC = CreateDC ("DISPLAY",NULL,NULL,NULL);
  TEXTMETRIC tm;
  GetTextMetrics (hDC,&tm);
  return tm.tmHeight - tm.tmInternalLeading;
  DeleteDC (hDC);
  }

HFONT GetDrawingFont ()
  {
  static HFONT hDrwFont;
  if (hDrwFont == 0) {
    hDrwFont = CreateFont (-GetSystemFontHeight(),
                     0,
                     0,
                     0,
                     FW_BOLD,
                     FALSE,
                     FALSE,
                     FALSE,
                     DEFAULT_CHARSET,
                     OUT_TT_PRECIS,
                     CLIP_DEFAULT_PRECIS,
                     DEFAULT_QUALITY,
                     DEFAULT_PITCH,
                     "ARIAL"
                    );
    }
  return hDrwFont;
  }

HFONT GetItalicFont (HFONT hfnt)
  {
  static HFONT hIDrwFont;
  LOGFONT lf;
  GetObject (hfnt,sizeof(LOGFONT),LPSTR(&lf));
  lf.lfItalic = TRUE ;
  if (hIDrwFont == 0) {
    hIDrwFont = CreateFontIndirect (&lf);
    }
  return hIDrwFont;
  }

static int actx0;
static int actAnzTabs;
static int FAR *actTabs;
BOOL MyTabbedTextOut (HDC hDC,LPARAM lP,int cch)
  {
  TabbedTextOut (hDC,0,0,
                      LPSTR (lP),
                      cch,
                      actAnzTabs,actTabs,actx0
                );
  return TRUE;
  }

void MyGrayString (HDC hDC,HBRUSH hBrush,FARPROC Tout,
                    LPARAM txt,int txtlen,
                    int x,int y,int cx,int cy,BOOL IsSelected)
  {
  HDC hmemDC = CreateCompatibleDC (hDC);
  HBITMAP hbmp = CreateCompatibleBitmap (hDC,cx,cy);
  hbmp = SelectObject (hmemDC,hbmp);

  LONG bkColor = GetBkColor(hDC);
  HBRUSH hmBrush = CreateSolidBrush (bkColor);
  hmBrush = SelectObject (hmemDC,hmBrush);
  HPEN hPen = CreatePen (PS_SOLID,0,bkColor);
  hPen = SelectObject (hmemDC,hPen);
  Rectangle (hmemDC,0,0,cx,cy);
  
  SetTextColor (hmemDC,(GetTextColor(hDC)));
  SetBkMode (hmemDC,TRANSPARENT);
  HFONT htFnt = SelectObject (hDC,GetStockObject (SYSTEM_FONT));
  SelectObject (hmemDC,htFnt);
  MyTabbedTextOut (hmemDC,txt,txtlen);
  SelectObject (hDC,htFnt);
  
  HBRUSH holdBrush = SelectObject (hDC,hBrush);
  if (IsSelected)
    BitBlt (hDC,x,y,cx,cy,hmemDC,0,0,MERGECOPY);
  else
    BitBlt (hDC,x,y,cx,cy,hmemDC,0,0,0x00FC008A);
  
  SelectObject (hDC,holdBrush);
  DeleteObject (SelectObject (hmemDC,hmBrush));
  DeleteObject (SelectObject(hmemDC,hbmp));
  DeleteObject (SelectObject(hmemDC,hPen));
  DeleteDC (hmemDC);
  }

static HBITMAP hdb;
static int diRefCount;
HBITMAP GetDisable ()
  {
  if (hdb == 0) 
    hdb = LoadBitmap (hLibInst,"Disable");
   
  diRefCount++;
  return hdb ;
  }

void ReleaseDisable ()
  {
  if (--diRefCount == 0) {
//    DeleteObject (hdb);
//    hdb = 0;
    }
  }

LONG FAR PASCAL SpcEdWinFunc (HWND hWnd,unsigned msg,WORD wP,LONG lP,
                                      BOOL FAR &done,
                                      edw_extradata FAR *x
                             )
  {
  done = FALSE ;
  LONG res = 0L;

  switch (msg) {
    case WM_CREATE :
      GetDisable ();    // Bitmap initialisieren
      x->hFnt = GetDrawingFont ();
      if (x->isKursiv) 
        x->hIFnt = GetItalicFont (x->hFnt);
      SendMessage (hWnd,WM_SETFONT,
                        (x->isKursiv) ? x->hIFnt : x->hFnt,
                        MAKELONG(FALSE,0)
                  );
      if (x->hFnt == 0) 
        MessageBeep (0);
      x->oisKursiv = x->isKursiv;
      x->oisDisabled = x->isDisabled;
      x->oisRed = x->isRed;
      break;

    case WM_DESTROY :
      ReleaseDisable ();
//      if (x->hFnt)  DeleteObject (x->hFnt),  x->hFnt = 0;
//      if (x->hIFnt) DeleteObject (x->hIFnt), x->hIFnt = 0;
      break ;

    case WM_SETTEXT :
      if (x->oisKursiv != x->isKursiv) {
        x->oisKursiv = x->isKursiv;

        if ((x->isKursiv) && (x->hIFnt == 0))
          x->hIFnt = GetItalicFont (x->hFnt);

        SendMessage (hWnd,WM_SETFONT,
                        (x->isKursiv) ? x->hIFnt : x->hFnt,
                        MAKELONG(TRUE,0)
                  );
        }

      if (x->oisDisabled != x->isDisabled) {
        EnableWindow (hWnd,!(x->oisDisabled = x->isDisabled));
        }

      break ;

    case WM_PAINT :
      if ((x->isRed) && (x->isDisabled)) {
        // Windows ist zu bloed, um einen roten disable auszufuehren
        PAINTSTRUCT ps;
        HDC hDC = BeginPaint(hWnd,&ps);
        RECT r;
        GetClientRect (hWnd,&r);
        Rectangle (hDC,r.left,r.top,r.right,r.bottom);
        // Und nun noch das rote Grau zeichnen
        char Txt[128];
        GetWindowText (hWnd,Txt,sizeof(Txt));
        if (*Txt) {
          HFONT hFnt = SelectObject (hDC,HFONT
                                          (SendMessage(hWnd,WM_GETFONT,0,0L))
                                    );
          TEXTMETRIC tm;
          GetTextMetrics (hDC,&tm);
          int dx = (r.bottom - tm.tmHeight) / 2;
          SetTextColor (hDC,RGB(0xFF,0,0));
          actx0 = 0;
          actAnzTabs = 0;
          actTabs = NULL;
          HBRUSH hBrush = CreatePatternBrush (GetDisable());
          MyGrayString (hDC,hBrush,FARPROC(MyTabbedTextOut),
                        LONG(LPSTR(Txt)),
                        lstrlen(Txt),
                        dx,dx,r.right - 2 * dx,r.bottom - 2 * dx,
                        FALSE
                       );
          DeleteObject (hBrush);
          SelectObject (hDC,hFnt);
          }
        EndPaint (hWnd,&ps);
        done = TRUE ;
        }
      break ;

    case WM_CTLCOLOR :
      if (x->isRed) {
        SetTextColor (wP,RGB(0xFF,0,0));
        }
      res = GetStockObject(WHITE_BRUSH);
      x->oisRed = x->isRed;
      done = TRUE ;

      break ;
    }

  return res;
  }


int FAR PASCAL MeassureFlaggedText (HFONT FAR *hfnt)
  {
  int res = 1;
  if (*hfnt == 0) {
    *hfnt = GetDrawingFont ();
    TEXTMETRIC tm;
    HDC hDC = CreateDC ("DISPLAY",NULL,NULL,NULL);
    HFONT hOldFont = SelectObject (hDC,*hfnt);
    GetTextMetrics (hDC,&tm);
    res = tm.tmHeight;
    SelectObject (hDC,hOldFont);
    DeleteDC (hDC);
    GetDisable ();    // Bitmap initialisieren
    }
  return res;
  }

void FAR PASCAL DrawFlaggedText (
                                  HFONT FAR *hfnt,
                                  HFONT FAR *hIfnt,
                                  DRAWITEMSTRUCT FAR *ds,
                                  LPSTR Txt,
                                  BOOL Disabled,
                                  BOOL Kursiv,
                                  BOOL Red,
                                  BOOL Gray,
                                  int xpos,
                                  int FAR *Tabs,
                                  int AnzTabs
                                          )
  {
  if (ds != NULL) {
    // Zeichnen
    int dsState = ds->itemState;
    if (dsState & ODS_SELECTED) {
      SelectObject (ds->hDC,GetStockObject (BLACK_BRUSH));
      SelectObject (ds->hDC,GetStockObject (BLACK_PEN));
      }
    else {
      SelectObject (ds->hDC,GetStockObject (WHITE_BRUSH));
      SelectObject (ds->hDC,GetStockObject (WHITE_PEN));
      }

    // Zeichnen eines leeren Rechteckes
    Rectangle (ds->hDC,ds->rcItem.left,ds->rcItem.top,
                        ds->rcItem.right,ds->rcItem.bottom);

    // Selektion einiger Attribute
    if (Red)
      SetTextColor (ds->hDC,RGB(0xFF,0,0));
    else if (Gray)
      SetTextColor (ds->hDC,RGB(0x80,0x80,0x80));
    else {
      if (dsState & ODS_SELECTED)
        SetTextColor (ds->hDC,RGB(0xFF,0xFF,0xFF));
      else
        SetTextColor (ds->hDC,RGB(0,0,0));
      }

    if (dsState & ODS_SELECTED)
      SetBkColor (ds->hDC,RGB(0,0,0));
    else
      SetBkColor (ds->hDC,RGB(0xFF,0xFF,0xFF));

    if (Kursiv) {
      if (*hfnt == 0) MessageBeep (0);
      if (*hIfnt == 0) *hIfnt = GetItalicFont (*hfnt);
      SelectObject (ds->hDC,*hIfnt);
      if (*hIfnt == 0) MessageBeep (0);
      }
    else {
      if (*hfnt == 0) MessageBeep (0);
      SelectObject (ds->hDC,*hfnt);
      }

    SetTextAlign (ds->hDC,TA_LEFT | TA_TOP);

    HBRUSH hBrush = 0;
    if (Disabled) {
      actx0 = ds->rcItem.left-xpos;
      actAnzTabs = AnzTabs;
      actTabs = Tabs;
      hBrush = CreatePatternBrush (GetDisable());
      MyGrayString (ds->hDC,hBrush,FARPROC(MyTabbedTextOut),
                  LONG(Txt),
                  lstrlen(Txt),
                  ds->rcItem.left-xpos,ds->rcItem.top,
                  ds->rcItem.right - ds->rcItem.left,
                  ds->rcItem.bottom - ds->rcItem.top,
                  dsState & ODS_SELECTED
                 );
      }
    else {
      // normale Ausgabe
      TabbedTextOut (ds->hDC,ds->rcItem.left-xpos,ds->rcItem.top,
                         Txt,
                         lstrlen(Txt),
                         AnzTabs,Tabs,ds->rcItem.left-xpos
                    );
      }

    if (hBrush) {
      DeleteObject (hBrush);
      ReleaseDisable ();
      }

    // Zeichnen des Focus
    if (dsState & ODS_FOCUS) {
      DrawFocusRect (ds->hDC,&ds->rcItem);
      }

    }
  else {
    // Loeschen der Fonts
    ReleaseDisable ();
    }
  }
