#include <winver.h>
#include "ddsvers.h"
#include "ddsrc.h"

ChildIcon  ICON    C:\ipos_kernel\PICTURES\MDICHILD.ICO
DocIcon    ICON    C:\ipos_kernel\PICTURES\DOCUMENT.ICO

