void _export FAR PASCAL IcnNotify (LPICONELEDATA ele,CreateIconFolder_param FAR *par,WORD code)
  {
  if (code == ICN_DOEXCUTE) {
    LPDBRECORD old = par->c->rr->GetRecord(par->TableInd);
    par->c->rr->SetRecord (par->TableInd,LPDBRECORD (ele->Record));
    par->c->ExCuteProc (par->cbProc,EM_LOAD | EM_CHANGETOTRUE);
    par->c->ExCuteProc (par->cbProc,EM_RESET);
    par->c->rr->SetRecord (par->TableInd,old);
    }
  else if (code == ICN_DOABORT) {
    par->c->ExCuteProc (par->abortProc,EM_LOAD | EM_CHANGETOTRUE);
    par->c->ExCuteProc (par->abortProc,EM_RESET);
    }
  }

ICNNOTIFY GetNotify()
  {
  static ICNNOTIFY lpntf;
  if (lpntf == NULL)
    lpntf = ICNNOTIFY (MakeProcInstance (FARPROC(IcnNotify),WBase::hInstance));
  return lpntf;
  }

BOOL CreateIconFolder (mdiChild *c,LPVOID param,WORD mode)
  {
  if (mode & EM_LOAD) {
    CreateIconFolder_param FAR *par = (CreateIconFolder_param FAR *) param ;
    par->c = c;

    c->WritelData (par->res,&par,sizeof(par),LPSTR(param)-sizeof(WORD));

    par->TableInd = 0xFFFF;
    LPSTR TableNameToChange = LPSTR (c->ReadlData (par->TableNameToChange));
    for (WORD i = 0 ; i < c->schd->AnzTables ; i++) {
      LPTABLEDEF td = GetTableAdmin()->GetTableDef(c->schd->TableNr[i]);
      if (lstrcmp(TableNameToChange,td->GetName()) == 0) {
        par->TableInd = i + 2;
        }
      GetTableAdmin()->FreeTable(td->GetTableID());
      }
    DBWIN_ASSERT (par->TableInd != 0xFFFF);

    HWND hWndDDS = WBase::hFrameWin ;
    LPSCREEN FAR *scl = (LPSCREEN FAR *) 
          c->ReadlData (par->Screen);
    HWND hWndParent = ((scl != NULL) && (*scl != NULL)) ? 
            (* scl)->hWnd : 
            hWndDDS;

    CreateGroupWindow (hWndParent,"",1,par,GetNotify());
    CreateIconWindow ("");
    }
  if (mode & (EM_RESET | EM_CLEAR)) {
    CreateIconFolder_param FAR *par = (CreateIconFolder_param FAR *) param ;
    par->c = NULL;
    CloseIconWnd ();
    }
  return FALSE ;
  }

struct AddIconEle_param {
  WORD parSize;
  DWORD cpar;
  DWORD prgName;
  };

BOOL AddIconEle (mdiChild *c,LPVOID param,WORD mode)
  {
  if (mode & EM_LOAD) {
    AddIconEle_param FAR *par = (AddIconEle_param FAR *) param;
    LPSTR prgName = LPSTR (c->ReadlData (par->prgName));
    LPCIFPAR FAR *cpar = (LPCIFPAR FAR *) c->ReadlData (par->cpar);
    DBWIN_ASSERT (prgName != NULL);
    DBWIN_ASSERT ((cpar != NULL) && (*cpar != NULL)) ;
    LPSCRIPTCONTENT ele = GetScriptEntry (prgName);
    DBWIN_ASSERT (ele != NULL);
    IconEleData d;
    d.sc = ele;
    LPDBRECORD r = c->rr->GetRecord ((*cpar)->TableInd);
    DBWIN_ASSERT (r != NULL);
    d.Record = r;
    if (ele->IconData != NULL) {
      // Ein Icon steht zur Verfuegung
      LPBITMAPINFO lpbmi = LPBITMAPINFO (ele->IconData);
      AddPmEle (ele->Name,lpbmi,&d);
      }
    else {
      AddPmEle (ele->Name,LoadDefIcon(),&d);
      }
    }
  return FALSE ;
  }

BOOL ShowIconFolder (mdiChild *c,LPVOID param,WORD mode)
  {
  if (mode & EM_LOAD) {
    GroupReady ();
    ShowGroupWindow ();
    }
  return FALSE ;
  }
