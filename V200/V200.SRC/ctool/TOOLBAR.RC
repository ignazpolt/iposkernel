#include <windows.h>
#include <winver.h>
#include "ddsvers.h"
#include "ddsrc.h"
#include "toolbar.dlg"

DN_PATTERN BITMAP C:\ipos_kernel\PICTURES\DNPATTRN.BMP
DISABLEBITS BITMAP C:\ipos_kernel\PICTURES\GRID.BMP
FOCUSBITS   BITMAP C:\ipos_kernel\PICTURES\FOCPAT.BMP
ICNPAGE     BITMAP C:\ipos_kernel\PICTURES\ICNPAGE.BMP
ICNCLOSE    BITMAP C:\ipos_kernel\PICTURES\ICNCLOSE.BMP
BUTTONS     BITMAP C:\ipos_kernel\PICTURES\BUTTONS.BMP
LEATHER     BITMAP C:\ipos_kernel\PICTURES\LEATHER.BMP
POSTITBACK  BITMAP  C:\ipos_kernel\PICTURES\postitbk.bmp
MULTION     BITMAP C:\ipos_kernel\PICTURES\MULTION.BMP
MULTIOFF    BITMAP C:\ipos_kernel\PICTURES\MULTIOFF.BMP
HAND        BITMAP C:\ipos_kernel\PICTURES\HAND.BMP

PAGECURSORLEFT CURSOR C:\ipos_kernel\PICTURES\lefthand.cur
PAGECURSORRIGHT CURSOR C:\ipos_kernel\PICTURES\rghthand.cur

PopupMenu MENU 
BEGIN 
  POPUP "Dummy Popup" 
    BEGIN 
      MENUITEM "Kurzhilfe...", 100, GRAYED
;      POPUP "Hotkeys..." 
    END 
 
END 


STRINGTABLE 
{
    1000,       "[kein]"
    1000+VK_F1, "F1"
    1000+VK_F2, "F2"
    1000+VK_F3, "F3"
    1000+VK_F4, "F4"
    1000+VK_F5, "F5"
    1000+VK_F6, "F6"
    1000+VK_F7, "F7"
    1000+VK_F8, "F8"
    1000+VK_F9, "F9"
    1000+VK_F10, "F10"
    1000+VK_F11, "F11"
    1000+VK_F12, "F12"
    1000+VK_INSERT, "INS"
    1000+VK_DELETE, "DEL"
    1000+VK_ESCAPE, "ESC"
    1000+VK_RETURN, "ENTER"
}

VS_VERSION_INFO VERSIONINFO

#ifdef WIN32
  FILEVERSION 4,0,PROGRAM_VERSION,SUB_VERSION
  PRODUCTVERSION 4,0,PROGRAM_VERSION,SUB_VERSION
  FILEOS VOS__WINDOWS32
#else
  FILEVERSION 3,10,PROGRAM_VERSION,SUB_VERSION
  PRODUCTVERSION 3,10,PROGRAM_VERSION,SUB_VERSION
  FILEOS VOS__WINDOWS16
#endif

#ifdef DEBUG
  FILEFLAGSMASK  VS_FF_DEBUG
#else
  FILEFLAGSMASK  VS_FF_DEBUG
#endif

FILEFLAGS 0x3F
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704E4"
        BEGIN
            VALUE "CompanyName", COMPANY_NAME
            VALUE "FileDescription", FILE_DESCRIPTION
            VALUE "FileVersion", FILE_VERSION
            VALUE "OriginalFilename", "CTOOL.DLL\0"
            VALUE "InternalName", "CTOOL\0"
            VALUE "LegalCopyright", LEGAL_COPYRIGHT
            VALUE "ProductName", PRODUCT_NAME
            VALUE "ProductVersion", PRODUCT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x407, 1252 
    END
END

