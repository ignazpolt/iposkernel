	POPUP "&Bearbeiten"
	BEGIN
		MENUITEM "&Ausschneiden\tStrg+X", IDM_CUT
		MENUITEM "&Kopieren\tStrg+C",     IDM_COPY
		MENUITEM "&Einf�gen\tStrg+V",     IDM_PASTE
                MENUITEM SEPARATOR
                MENUITEM "&Zeile l�schen\tStrg+Y",        IDM_DELLINE

	END

	POPUP "&Suchen"
	BEGIN
		MENUITEM "Suchen \tF5", MI_SEARCH
