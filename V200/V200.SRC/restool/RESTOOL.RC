FldAcc ACCELERATORS
   BEGIN
      "^S"                              , 110
      "^A"                              , 111
      "^K"                              , 100
      "^F"                              , 102
      "^Y"                              , 1000
      VK_RETURN                         , 1001 , CONTROL , VIRTKEY
   END


