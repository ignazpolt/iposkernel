  BEGIN
      MENUITEM "�berschriften"          , MI_HDFONT
      MENUITEM "Tabelle"                , MI_LIFONT
  END

FRMENU MENU
  BEGIN
      POPUP "&Skalierung"
      BEGIN
        MENUITEM "Vergr��ern \t^Numpad+"  , MI_BIGGERSCALE
        MENUITEM "Verkleinern \t^Numpad-" , MI_SMALLERSCALE
      END
  END

DlgAcc ACCELERATORS
   BEGIN
      "^F"                              , CMD_TB_BASE+100
      "^S"                              , MI_STOREDIALOG
      "^E"                              , MI_DIALED
      "^W"                              , MI_WORKONELE
;      "^C"                              , MI_DUPLICATE
      "^Y"                              , IDM_DELLINE
      VK_F2                             , MI_TOGGLEBOOKMARK     , CONTROL, VIRTKEY
      VK_F2                             , MI_NEXTBOOKMARK     , VIRTKEY
      VK_F2                             , MI_PREVBOOKMARK     , SHIFT, VIRTKEY

      VK_F5                             , MI_MOVEELEMES         , ALT , VIRTKEY
;      VK_F1                             , MI_WORKONELE          , VIRTKEY
      VK_F1                             , IDM_HELPONITEM        , VIRTKEY
      VK_F7                             , MI_DESTROYDIALOG      , VIRTKEY
      VK_F2                             , MI_WORKONSCREEN       , VIRTKEY
      VK_F4                             , MI_DELELE             , VIRTKEY
      VK_F10                            , MI_STEP               , VIRTKEY
      VK_F8                             , MI_STEPINTO           , VIRTKEY
      "c"                               , MI_SHOWSTACK          , ALT
      "u"                               , MI_SHOWUPDATE         , ALT
      VK_F10                            , MI_GENED              , ALT , VIRTKEY
      VK_F10                            , MI_GENED_DEPEND       , ALT , SHIFT , VIRTKEY
      VK_F10                            , MI_GENMAKEFILE        , CONTROL , SHIFT , VIRTKEY
      VK_F9                             , MI_SETBREAK           , VIRTKEY
      VK_F9                             , MI_WATCHVAR           , SHIFT , VIRTKEY
      VK_F8                             , MI_CREATEWATCH        , CONTROL , VIRTKEY
      "w"                               , MI_STOREED            , ALT
      "n"                               , MI_NEXTBUFFER         , ALT
      0x30                              , MI_MAINFILE           , CONTROL , VIRTKEY
      0x31                              , MI_INCLUDE            , CONTROL , VIRTKEY
      0x32                              , MI_INCLUDE + 1        , CONTROL , VIRTKEY
      0x33                              , MI_INCLUDE + 2        , CONTROL , VIRTKEY
      0x34                              , MI_INCLUDE + 3        , CONTROL , VIRTKEY
      0x35                              , MI_INCLUDE + 4        , CONTROL , VIRTKEY
      0x36                              , MI_INCLUDE + 5        , CONTROL , VIRTKEY
      0x37                              , MI_INCLUDE + 6        , CONTROL , VIRTKEY
      0x38                              , MI_INCLUDE + 7        , CONTROL , VIRTKEY
      0x39                              , MI_INCLUDE + 8        , CONTROL , VIRTKEY
      VK_F3                             , MI_SEARCH             , ALT, VIRTKEY
      VK_F3                             , MI_SEARCHMORE         , VIRTKEY
      VK_F3                             , MI_SEARCHUP           , SHIFT , VIRTKEY
      VK_F6                             , MI_REPLACE            , VIRTKEY
      VK_F6                             , MI_REPLACEMORE        , SHIFT , VIRTKEY
      VK_F9                             , MI_NEWHLINE           , SHIFT , CONTROL , ALT , VIRTKEY
      VK_F9                             , MI_NEWVLINE           , CONTROL , VIRTKEY 
      VK_F9                             , MI_DELHLINE           , ALT , VIRTKEY 
      VK_F9                             , MI_WORKONHLINE        , CONTROL , SHIFT , VIRTKEY 
      VK_F9                             , MI_MULTIHLINE         , ALT , SHIFT , VIRTKEY 
      "^U"                              , MI_INDENVORDERGRUND
      "^B"                              , MI_INDENHINTERGRUND
      VK_INSERT                         , IDM_COPY              , CONTROL , VIRTKEY
      "^C"                              , IDM_COPY
      VK_INSERT                         , IDM_PASTE             , SHIFT , VIRTKEY
      "^V"                              , IDM_PASTE
      VK_DELETE                         , IDM_CUT               , SHIFT, VIRTKEY
      "^X"                              , IDM_CUT
      VK_ADD                            , MI_BIGGERSCALE        , CONTROL , VIRTKEY
      VK_SUBTRACT                       , MI_SMALLERSCALE       , CONTROL , VIRTKEY
      "^T"                              , MI_INSERTTEMPLATE
      VK_F7                             , MI_EXPANDWATCH, CONTROL , VIRTKEY 
      VK_F7                             , MI_DELWATCH, ALT , VIRTKEY 
      VK_F7                             , MI_FOCUSTOLIST, SHIFT , VIRTKEY
      "^K"                              , MI_FINDMATCHINGBRACES
   END

FrmAcc ACCELERATORS
   BEGIN
;      VK_ADD                            , MI_BIGGERSCALE        , CONTROL , VIRTKEY
;      VK_SUBTRACT                       , MI_SMALLERSCALE       , CONTROL , VIRTKEY
      "^S"                              , MI_STOREDIALOG
      VK_F7                             , MI_DESTROYDIALOG      , VIRTKEY
   END

DeskAcc ACCELERATORS
   BEGIN
      "1"                               , MI_WFILECOMMAND       , ALT
      "2"                               , MI_WFILECOMMAND + 1   , ALT
      "3"                               , MI_WFILECOMMAND + 2   , ALT
      "4"                               , MI_WFILECOMMAND + 3   , ALT
      "5"                               , MI_WFILECOMMAND + 4   , ALT
      "6"                               , MI_WFILECOMMAND + 5   , ALT
      "7"                               , MI_WFILECOMMAND + 6   , ALT
      "8"                               , MI_WFILECOMMAND + 7   , ALT
      "9"                               , MI_WFILECOMMAND + 8   , ALT

      "^O"                              , MI_OPENFORSCRIPTED
      "^D"                              , MI_TABLELIST
      "^J"                              , MI_GENINT
      "^G"                              , MI_SHOWGLOB

      VK_F5                             , MI_RUN                , VIRTKEY
      "B"                               , MI_BREAKLIST          , CONTROL, SHIFT, VIRTKEY
   END


STRINGTABLE 
BEGIN
    IDS_UNTITLED  "Untitled"
    IDS_APPNAME   "Clinicum Resource - Tool"

