;--------------------------------------------------------------------------
; Menu-Struktur fuer ein offenes Script-Fenster
;--------------------------------------------------------------------------
MainMenu MENU 
BEGIN
	POPUP "&Datei"
	BEGIN
		MENUITEM "&Neu", IDM_FILENEW
		MENUITEM "�&ffnen...\tStrg+O", MI_OPENFORSCRIPTED
		MENUITEM "Sch&lie�en", IDM_FILECLOSE, GRAYED
		MENUITEM "&Speichern\tAlt+W", MI_STOREED, GRAYED
		MENUITEM "Speichern &unter...", IDM_FILESAVEAS, GRAYED
		MENUITEM "&Alles Speichern", IDM_FILESAVEALL, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Beenden", IDM_FILEEXIT
		MENUITEM SEPARATOR
	END

	POPUP "&Bearbeiten"
	BEGIN
		; MENUITEM "R�ckg�ngig\tAlt+Backspace", 0, GRAYED
		; MENUITEM "Widerrufen\tShift+Alt+BackSpace", 0, GRAYED
		; MENUITEM SEPARATOR
		MENUITEM "&Ausschneiden\tStrg+X", IDM_CUT, GRAYED
		MENUITEM "&Kopieren\tStrg+C", IDM_COPY, GRAYED
		MENUITEM "&Einf�gen\tStrg+V", IDM_PASTE, GRAYED
		MENUITEM "&L�schen\tDEL", IDM_CLEAR, GRAYED
		MENUITEM "Duplizieren", 0, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "Alles Markieren", 0, GRAYED
		MENUITEM "Suchen...\tAlt+F3", MI_SEARCH, GRAYED
		MENUITEM "Weitersuchen\tF3", MI_SEARCHMORE, GRAYED
		MENUITEM "R�ckw�rts suchen\tShift+F3", MI_SEARCHUP, GRAYED
		MENUITEM "Ersetzen...\tF6", MI_REPLACE, GRAYED
		MENUITEM "Weiter ersetzen...\tShift+F6", MI_REPLACEMORE, GRAYED
		MENUITEM SEPARATOR
    MENUITEM "Lesezeichen ein/aus\tStrg+F2", MI_TOGGLEBOOKMARK, GRAYED
    MENUITEM "Lesezeichen weiter\tF2", MI_NEXTBOOKMARK, GRAYED
    MENUITEM "Lesezeichen zur�ck\tShift+F2", MI_PREVBOOKMARK, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "Einf�gen &Template...\tStrg+T", MI_INSERTTEMPLATE, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "Dialogfenster\tStrg+E", MI_DIALED

	END

	POPUP "&Projekt"
	BEGIN
		MENUITEM "Generieren\tAlt+F10", MI_GENED
		MENUITEM "Generieren (mit Abh.)\tAlt+Shift+F10", MI_GENED_DEPEND
		MENUITEM "Generieren f�r Makefile(mit Abh.)\tStrg+Shift+F10", MI_GENMAKEFILE
		MENUITEM SEPARATOR
		MENUITEM "Resource erzeugen aus Beschreibungsdatei...", MI_GENRES
		; MENUITEM "Datenbank Konvertierung...", MI_DBCONV
		MENUITEM "&Funktionsprototypen...", MI_SETFNC
		MENUITEM SEPARATOR
		MENUITEM "Liste aller Scripts...", MI_SCRIPTLIST
		MENUITEM "Generiere &Scripts...", MI_GENERATESCRIPT
		MENUITEM SEPARATOR
		MENUITEM "&Liste aller Tabellen...\tStrg+D", MI_TABLELIST
		MENUITEM "Liste aller &Views...\tStrg+V", MI_GENINT
                MENUITEM "Liste aller &Structs...\tStrg+S", MI_SHOWGLOB
		MENUITEM "&RI - Diagramme...", MI_RIDIAGS
		MENUITEM SEPARATOR
		MENUITEM "Resourcen...", MI_SHOWRES
		MENUITEM "Formate...", MI_SHOWFMT
		MENUITEM "Farben...", MI_SHOWCOLOR
#ifdef UEBERLEGT
		MENUITEM SEPARATOR
		MENUITEM "SQL - Verbindung...", MI_CONNECTTOSQL
#endif
	END

        POPUP "D&ebug"
        BEGIN
		MENUITEM "Go\tF5",                  MI_RUN,        
                MENUITEM "Step Into\tF8",           MI_STEP,       
                MENUITEM "Step Over\tF10",          MI_STEPINTO,   
		MENUITEM SEPARATOR
                MENUITEM "Show Call Stack\tAlt+C",  MI_SHOWSTACK,  
                MENUITEM "Breakpoint setzen\tF9",   MI_SETBREAK,   GRAYED
                MENUITEM "Breakpoints\tStrg+Shift+B",     MI_BREAKLIST
                MENUITEM "Quick Watch\tShift+F9",   MI_WATCHVAR,   GRAYED
		MENUITEM SEPARATOR
                MENUITEM "&Watch",                       MI_SHOWWATCHVAR
                MENUITEM "Expand Variable\tStrg+F7",     MI_EXPANDWATCH, GRAYED
                MENUITEM "Break at Change",              MI_WATCHBREAK, GRAYED
                MENUITEM "Delete Watch\tAlt+F7",         MI_DELWATCH, GRAYED
                MENUITEM "Focus to Variables\tShift+F7", MI_FOCUSTOLIST, GRAYED
                MENUITEM "Terminate Clinicum" , MI_DESTROYDDS
                MENUITEM "Break immediately" , MI_BREAKDDS
        END

	POPUP "&Optionen"
	BEGIN
		; MENUITEM "Verzeichnisse...", IDM_PATH
		; MENUITEM "Editor...", IDM_EDIT
		MENUITEM "Font...", IDM_EDITORFONT
	END

	POPUP "&Fenster"
	BEGIN
		MENUITEM "&Nebeneinander", IDM_WINDOWTILE
		MENUITEM "&�berlappend", IDM_WINDOWCASCADE
		MENUITEM "Arrange &Icons", IDM_WINDOWICONS
		MENUITEM "&Alles schlie�en", IDM_WINDOWCLOSEALL
	END

END


;--------------------------------------------------------------------------
; Menu-Struktur fuer ein Dialog- oder Formular - Fenster
;--------------------------------------------------------------------------
DialogMenu MENU 
BEGIN
	POPUP "&Datei"
	BEGIN
		MENUITEM "&Neu", IDM_FILENEW
		MENUITEM "�&ffnen...\tStrg+O", MI_OPENFORSCRIPTED
		MENUITEM "Sch&lie�en", IDM_FILECLOSE, GRAYED
		MENUITEM "&Speichern", MI_STOREED, GRAYED
		MENUITEM "Speichern &unter...", IDM_FILESAVEAS, GRAYED
		MENUITEM "&Alles Speichern", IDM_FILESAVEALL, GRAYED
		MENUITEM SEPARATOR
		MENUITEM "&Beenden", IDM_FILEEXIT
		MENUITEM SEPARATOR
	END

        POPUP "Dia&log"
        BEGIN
			MENUITEM "Speichern \tStrg+S,F10", MI_STOREDIALOG
			MENUITEM "Abbrechen \tF7", MI_DESTROYDIALOG
			MENUITEM SEPARATOR
			MENUITEM "Element l�schen \tF4", MI_DELELE
			MENUITEM "Element kopieren \tStrg+C", MI_DUPLICATE
			MENUITEM "Element bearbeiten \tStrg+W,F1", MI_WORKONELE
			MENUITEM "Element(e) verschieben \tALT+F5", MI_MOVEELEMES
			MENUITEM SEPARATOR
			MENUITEM "Schirm bearbeiten \tF2", MI_WORKONSCREEN
			MENUITEM SEPARATOR
			MENUITEM "Sortierreihenfolge ein/aus \tStrg+O", MI_SHOWSORT
			MENUITEM "In den Vordergrund \tStrg+U", MI_INDENVORDERGRUND
           		MENUITEM "In den Hintergrund \tStrg+B", MI_INDENHINTERGRUND
        END

        POPUP "Hilfs&linien"
        BEGIN
                MENUITEM "Horizontal \aF9", MI_NEWHLINE
                MENUITEM "Vertikal \aStrg+F9", MI_NEWVLINE
                MENUITEM "L�schen\aAlt+F9", MI_DELHLINE
                MENUITEM "Bearbeiten\aStrg+Shift+F9", MI_WORKONHLINE
                MENUITEM "Serie von Hilfslinien\aAlt+Shift+F9", MI_MULTIHLINE
                MENUITEM "Raster Einstellungen", MI_SETRASTER


        END

        POPUP "&Debug"
        BEGIN
		MENUITEM "Go\tF5",                  MI_RUN,        GRAYED
                MENUITEM "Step Into\tF8",           MI_STEP,       GRAYED
                MENUITEM "Step Over\tF10",          MI_STEPINTO,   GRAYED
		MENUITEM SEPARATOR
                MENUITEM "Show Call Stack\tAlt+C",  MI_SHOWSTACK,  GRAYED
                MENUITEM "Breakpoint setzen\tF9",   MI_SETBREAK,   GRAYED
                MENUITEM "Breakpoints\tStrg+Shift+B",         MI_BREAKLIST
                MENUITEM "Quick Watch",             MI_WATCHVAR,   GRAYED
		MENUITEM SEPARATOR
                MENUITEM "&Watch",                  MI_SHOWWATCHVAR
        END

	POPUP "&Optionen"
	BEGIN
		MENUITEM "Verzeichnisse...", IDM_PATH
		MENUITEM "Editor...", IDM_EDIT
		MENUITEM "Font...", IDM_EDITORFONT
	END

	POPUP "&Fenster"
	BEGIN
		MENUITEM "&Nebeneinander", IDM_WINDOWTILE
		MENUITEM "&�berlappend", IDM_WINDOWCASCADE
		MENUITEM "Arrange &Icons", IDM_WINDOWICONS
		MENUITEM "&Alles schlie�en", IDM_WINDOWCLOSEALL
;		MENUITEM SEPARATOR
;		MENUITEM "Meldungen anzeigen", MI_OUTPUTOPT
;		MENUITEM "Ausgabebildschirm l�schen", MI_CLEARSCREEN
	END

END

