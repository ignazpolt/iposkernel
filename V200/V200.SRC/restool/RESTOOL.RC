		MENUITEM SEPARATOR
		MENUITEM "Beenden\tF7",            MI_DESTROYDIALOG
	END

	POPUP "Element"
	BEGIN
		MENUITEM "L�schen\tF4",               MI_DELELE
		MENUITEM "Kopieren \tStrg+C",         MI_DUPLICATE
