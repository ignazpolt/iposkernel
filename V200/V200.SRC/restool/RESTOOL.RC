		MENUITEM "Verschieben \tALT+F5",      MI_MOVEELEMES
 		MENUITEM SEPARATOR
	END

	POPUP "Hilfslinien"
	BEGIN
		MENUITEM "Neu Horizontal \aF9", MI_NEWHLINE
		MENUITEM "Neu Vertikal \aStrg+F9", MI_NEWVLINE
		MENUITEM "L�schen ALT \aF9", MI_DELHLINE
		MENUITEM "Bearbeiten \aStrg+Shift+F9", MI_WORKONHLINE
		MENUITEM "Serie von Hilfslinien    \aALT+Shift+F9", MI_MULTIHLINE
	END

END

EDITMENU MENU 
BEGIN
	POPUP "&Datei"
	BEGIN
		MENUITEM "Speichern \tALT+w", MI_STOREED
		MENUITEM "Generieren \tALT+F10", MI_GENED
		MENUITEM "Beenden", MI_CLOSESC
		MENUITEM SEPARATOR
		MENUITEM "N�chster Buffer \tALT+n", MI_NEXTBUFFER
		MENUITEM "Hauptprogramm \tStrg+0", MI_MAINFILE
