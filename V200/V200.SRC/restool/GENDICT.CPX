BOOL GenResScript (HWND hWnd,LPSTR fname)
  {
  SetActFileName (fname);
  ResCompiler FAR *r = new ResCompiler ();
  RCmp = r;
  hRsWnd = hWnd;
  char pattern[64];
  char outtxt[128];
  LoadString (HINSTANCE(MyInstance),ID_RSCMPHEADLINE,pattern,sizeof(pattern));
  wsprintf (outtxt,pattern,fname);
  ShowMsg (outtxt,TRUE);
  UpdateWindow (hRsWnd);
  r->DoParse (fname,&rssyntax,NULL);
  FreeTableList (r->wError == 0);
  ClearInternTable ();
  if (r->wError == 0) {
    GetTableAdmin()->ReInitialize ();
    }
  return (r->wError == 0) ;
  }

void AnalyseIntTable (HWND hWnd,LPSTR fname)
  {
  OFSTRUCT Of;
  int fi = OpenFile (fname,&Of,OF_EXIST);
  doAnalyse = TRUE ;
  if (fi >= 0) {
    // Na versuchen wirs mal
    SetActFileName (fname);
    ResCompiler FAR *r = new ResCompiler ();
    RCmp = r;
    hRsWnd = hWnd;
    r->DoParse (fname,&rssyntax,NULL);
    }
  doAnalyse = FALSE ;
  }
