Acc ACCELERATORS
   Begin
/*
      "^O",       MI_M_ausfuehren
*/
      "^T",           MI_Digitizer
      "^S",           MI_Scanner
      "^D",           MI_Config
      "^F",           MI_Formats
      "^J",           MI_PrintJob
      "^G",           MI_Anzeige
      "^U",           MI_CASCADE
      "^N",           MI_TILE
      "^O",           10020
      VK_F1,          MI_H_Help_DDS        , VIRTKEY
      "^C",           MI_Copy
      VK_INSERT,      MI_Copy              , CONTROL , VIRTKEY
      "^V",           MI_Insert
      VK_INSERT,      MI_Insert            , SHIFT   , VIRTKEY
      "^X",           MI_Cut
      VK_DELETE,      MI_Cut               , SHIFT   , VIRTKEY
   End

