#define PICTEXTENSION   ".DBM"

struct ProgEntry {
  ProgEntry FAR *Next;
  int  Lfndr;
  int  idcbase;
  int  AnzDType;
  WORD Category;
  int  dbnr[5];
  char HeadLine[128];
  char fname[13];
  DWORD progSize;
  WORD ExtraInfo;
  };    // Direkt dahinter steht die Extra - Info

typedef ProgEntry FAR *LPPE;

#define DOCLISTSECTION          "DocList"
#define PICTPATH                "PictPath"
#define PICTPATHDEF             ".\\"
#define DEFPICT                 "doc"

#define DOCSECTION              "Documents"
#define DOCCOUNT                "MaxDocCount"
#define DOCCOUNTDEF             5

#define DC_NORMAL       0
#define DC_LISTITEM     1
#define DC_EXTRAITEM    2
#define DC_USERITEM     3
