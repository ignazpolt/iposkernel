DELLISTDLG DIALOG 108, 33, 150, 90
STYLE WS_POPUP | WS_BORDER
FONT 8, "Arial"
BEGIN
 CONTROL "", 101, "DDSLISTCLASS", NOT WS_VISIBLE, 0, 0, 150, 76
 PUSHBUTTON "OK", IDOK, 0, 76, 50, 14
 PUSHBUTTON "Abbruch", IDCANCEL, 50, 76, 50, 14
 PUSHBUTTON "Löschen", IDB_DELETE, 100, 76, 50, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END

HOTKEYS DIALOG 96, 43, 173, 122
STYLE DS_MODALFRAME | WS_OVERLAPPED | WS_CAPTION
CAPTION "HOT - KEYS"
FONT 8, "Arial"
BEGIN
	CONTROL "OK", IDOK, "BUTTON", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 120, 18, 44, 14
	EDITTEXT 101, 10, 76, 102, 12, ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP
	LTEXT "Liste aller Hotkeys:", -1, 6, 6, 80, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
	CONTROL "", 102, "LISTBOX", LBS_NOTIFY | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL | WS_GROUP | WS_TABSTOP, 4, 18, 102, 42
	PUSHBUTTON "Abbruch", IDCANCEL, 120, 36, 44, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Zuordnen", 103, 120, 74, 44, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Entfernen", 104, 120, 92, 44, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "Hotkey", -1, "button", BS_GROUPBOX | WS_CHILD | WS_VISIBLE | WS_GROUP, 4, 62, 166, 50
END
