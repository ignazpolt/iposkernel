#define IDB_DELETE 100


DLISTDLG DIALOG 108, 23, 152, 96
STYLE WS_POPUP | WS_BORDER
FONT 8, "Arial"
BEGIN
 CONTROL "", 101, "DDSLISTCLASS", NOT WS_VISIBLE, 0, 0, 152, 82
 PUSHBUTTON "OK", IDOK, 0, 82, 76, 14
 PUSHBUTTON "Abbruch", IDCANCEL, 76, 82, 76, 14
END

