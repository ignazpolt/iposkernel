COPY ..\..\%ACTVERS%.SRC\STATBAR\statbar.L32

rc -r -v -dWIN32 -fostatbar.res ..\..\%ACTVERS%.SRC\STATBAR\statbar.rc

link /DLL /DEBUG @statbar.l32
if errorlevel 1 goto error
goto continue
:error
pause
:continue

copy statbar.dll ..\*.*
copy statbar.lib ..\*.*
copy statbar.exp ..\*.*
copy statbar.dll ..\restool\*.*
