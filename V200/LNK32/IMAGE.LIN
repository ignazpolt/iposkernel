COPY ..\..\%ACTVERS%.SRC\IMAGE\tiff.L32

rc -r -v -dWIN32 -fotiffimg.res ..\..\%ACTVERS%.SRC\IMAGE\tiffimg.rc

link /DLL /DEBUG @tiff.l32
if errorlevel 1 goto error
goto continue
:error
pause
:continue

copy tiffimg.dll ..\*.*
copy tiffimg.lib ..\*.*
copy tiffimg.exp ..\*.*
copy tiffimg.dll ..\restool\*.*
