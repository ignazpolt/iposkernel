EXETYPE   WINDOWS
CODE      PRELOAD MOVEABLE DISCARDABLE
DATA      PRELOAD FIXED SINGLE
HEAPSIZE  4096

EXPORTS
;    ===List your explicitly exported functions here===
  WEP                                                                           @1 	RESIDENTNAME
  DBCALL                   = ?DBCall@@ZCHGHPEUDBRequest@@PEPEXPEURecBuffer@@@Z  @2
  DBRESET                  = ?DBReset@@ZCXXZ                                    @3
