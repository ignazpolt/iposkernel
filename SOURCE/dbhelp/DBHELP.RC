STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Daten Konvertieren"
BEGIN
  LTEXT "Tabelle:", -1, 4, 10, 31, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
  CONTROL "", 101, "EDIT", ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_BORDER | WS_TABSTOP, 39, 8, 116, 12
  LTEXT "Satz Nr:", -1, 4, 28, 31, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
  CONTROL "", 102, "EDIT", ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_BORDER | WS_TABSTOP, 39, 26, 34, 12
  PUSHBUTTON "Abbrechen", IDCANCEL, 111, 43, 44, 15, WS_CHILD | WS_VISIBLE | WS_TABSTOP
  LTEXT "Fehler Nr:", -1, 81, 28, 36, 8, WS_CHILD | WS_VISIBLE | WS_GROUP
  CONTROL "", 103, "EDIT", ES_LEFT | ES_READONLY | WS_CHILD | WS_VISIBLE | WS_DISABLED | WS_BORDER | WS_TABSTOP, 121, 26, 34, 12
END

