FINDDLG DIALOG 30, 73, 236, 62
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Find"
FONT 8, "Helv"
BEGIN
    LTEXT           "Fi&nd What:", -1, 4, 8, 42, 8, NOT WS_GROUP
    EDITTEXT        1152, 470, 7, 128, 12, ES_AUTOHSCROLL | WS_GROUP | NOT 
                    WS_TABSTOP
    COMBOBOX        1136, 47, 7, 128, 72, CBS_DROPDOWN | CBS_AUTOHSCROLL | 
                    WS_BORDER | WS_VSCROLL | WS_GROUP | WS_TABSTOP
    CONTROL         "Match &Whole Word Only", 1040, "Button", 
                    BS_AUTOCHECKBOX | WS_GROUP | WS_TABSTOP, 4, 26, 100, 12
    CONTROL         "Match &Case", 1041, "Button", BS_AUTOCHECKBOX | 
                    WS_TABSTOP, 4, 42, 64, 12
    GROUPBOX        "Direction", 1072, 107, 26, 68, 28
    CONTROL         "&Up", 1056, "Button", BS_AUTORADIOBUTTON | WS_GROUP | 
                    WS_TABSTOP, 111, 38, 20, 12
    CONTROL         "&Down", 1057, "Button", BS_AUTORADIOBUTTON | WS_TABSTOP, 
                    138, 38, 30, 12
    DEFPUSHBUTTON   "&Find Next", IDOK, 182, 5, 50, 14, WS_GROUP
    PUSHBUTTON      "Cancel", IDCANCEL, 182, 23, 50, 14, WS_GROUP
    PUSHBUTTON      "&Help", 1038, 182, 45, 50, 14, WS_GROUP
END

