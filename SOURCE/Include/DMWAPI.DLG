
BEMEDLIST DIALOG 42, 18, 228, 126
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Eingabe eines Memo Eintrages"
BEGIN
    CONTROL         "", 101, "WORDWIN", WS_BORDER | WS_TABSTOP | 0x0080, 6, 
                    6, 216, 14
    LISTBOX         100, 6, 21, 216, 84, NOT LBS_NOTIFY | 
                    LBS_OWNERDRAWVARIABLE | LBS_HASSTRINGS | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "OK", IDOK, 183, 108, 40, 14
    PUSHBUTTON      "Abbruch", IDCANCEL, 138, 108, 40, 14
END

