SHENT DIALOG 15, 33, 273, 174
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Kürzelbearbeitung"
BEGIN
    LISTBOX         101, 6, 6, 216, 75, LBS_OWNERDRAWFIXED | WS_VSCROLL | 
                    WS_TABSTOP
    PUSHBUTTON      "Schließen", IDCANCEL, 225, 51, 45, 14
    PUSHBUTTON      "Optionen>>", 100, 225, 36, 45, 14
    PUSHBUTTON      "Neu>>", 102, 225, 21, 45, 14
    PUSHBUTTON      "Ändern>>", 110, 225, 6, 45, 14
    EDITTEXT        104, 6, 108, 168, 12, ES_AUTOHSCROLL
    EDITTEXT        105, 6, 141, 183, 12, ES_AUTOHSCROLL
    LTEXT           "Aktuelles Kürzel", -1, 6, 96, 69, 8
    CONTROL         "Benutzerdef.", 108, "Button", BS_AUTOCHECKBOX | 
                    WS_TABSTOP, 93, 96, 69, 10
    LISTBOX         109, 192, 99, 75, 54, WS_VSCROLL | WS_TABSTOP
    LTEXT           "Langtext", -1, 6, 129, 60, 8
    CONTROL         "Benutzerdef.", 112, "Button", BS_AUTOCHECKBOX | 
                    WS_TABSTOP, 90, 126, 69, 10
    PUSHBUTTON      "OK", 103, 228, 156, 40, 14
    PUSHBUTTON      "Abbruch", 111, 183, 156, 40, 14
    PUSHBUTTON      "+", 114, 174, 108, 15, 12
    PUSHBUTTON      "Übernehmen", IDOK, 225, 66, 45, 14
END

SHOPT DIALOG 21, 57, 339, 54
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
