	PUSHBUTTON "Import", 100, 6, 6, 75, 14
	PUSHBUTTON "Export", 102, 6, 21, 75, 14
	CONTROL "Lese Zeile %d (%s)", 101, "STATIC", NOT WS_VISIBLE, 87, 9, 249, 8
END

MLIST DIALOG 42, 57, 486, 156
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
